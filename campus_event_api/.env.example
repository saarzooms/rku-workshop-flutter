# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campus_event_db
DB_USERNAME=root
DB_PASSWORD=

# Authentication
TOKEN_TTL_HOURS=168
QR_TOKEN_DEFAULT_TTL_MINUTES=15

# Firebase Cloud Messaging (HTTP v1)
# Path to Firebase service account JSON OUTSIDE public/ directory
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=../storage/firebase-service-account.json
